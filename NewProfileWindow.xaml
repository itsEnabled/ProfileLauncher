<Window x:Class="ProfileLauncher.NewProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New client profile" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <!-- A colour swatch: the Background is the colour, a ring shows which one is picked. -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Ring" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent"/>
                            <Border Margin="5" CornerRadius="6" Background="{TemplateBinding Background}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,22,24,20">
        <TextBlock Style="{StaticResource Label}" Text="CLIENT NAME"/>
        <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
            <TextBox x:Name="NameBox" MaxLength="60" Background="Transparent" BorderThickness="0" Padding="10,8" FontSize="14"
                     Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                     TextChanged="NameBox_TextChanged"/>
        </Border>

        <TextBlock Style="{StaticResource Label}" Text="ENVIRONMENT"/>
        <UniformGrid Rows="1" Margin="0,0,0,20">
            <RadioButton x:Name="EnvGcch" Style="{StaticResource Segment}" GroupName="Env" Content="GCCH"
                         Margin="0" IsChecked="True"/>
            <RadioButton x:Name="EnvCommercial" Style="{StaticResource Segment}" GroupName="Env"
                         Content="GCC/Commercial" Margin="2,0,0,0"/>
        </UniformGrid>

        <TextBlock Style="{StaticResource Label}" Text="CREATE IN"/>
        <StackPanel Orientation="Horizontal" Margin="2,0,0,20">
            <CheckBox x:Name="InChrome" Content="Chrome" Foreground="{DynamicResource TextPrimary}"
                      Margin="0,0,22,0" Click="Browser_Click"/>
            <CheckBox x:Name="InEdge" Content="Edge" Foreground="{DynamicResource TextPrimary}"
                      Click="Browser_Click"/>
        </StackPanel>

        <TextBlock Style="{StaticResource Label}" Text="COLOR"/>
        <WrapPanel x:Name="Swatches" Margin="0,0,0,14"/>

        <TextBlock x:Name="Note" TextWrapping="Wrap" FontSize="11.5" Margin="2,0,0,18"
                   Foreground="{DynamicResource TextSecondary}"
                   Text="The profile opens straight away so the browser can register it. Its tile appears a moment later."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource PillButton}" Content="Cancel" MinWidth="90" IsCancel="True"/>
            <Button x:Name="CreateButton" Style="{StaticResource PillButton}" Content="Create and open"
                    MinWidth="140" Margin="8,0,0,0" IsDefault="True" IsEnabled="False" Click="Create_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
