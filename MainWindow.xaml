<Window x:Class="ProfileLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile Launcher"
        Width="1100" Height="720" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- A tile is a button with no chrome: just a soft hover plate behind the content. -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="Transparent" CornerRadius="14" Padding="8,12,8,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The favourite star: hidden until the tile is hovered, always shown once set. -->
        <Style x:Key="StarButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Side panel ============ -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,20,10,12">
                <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}"
                        Content="&#x2699;   Settings" Click="Settings_Click"/>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" Margin="0,0,0,2"
                        Content="&#xFF0B;   New profile" Click="NewProfile_Click"/>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabel}" Text="CLIENTS"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="Nav" Tag="All"
                                 HorizontalContentAlignment="Left" Content="All clients"
                                 Checked="Nav_Checked" IsChecked="True"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="Nav" Tag="Favourites"
                                 HorizontalContentAlignment="Left" Content="&#x2605;   Favorites"
                                 Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Main area ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar: search, browser filter, count -->
            <Grid Grid.Row="0" Margin="20,18,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <TextBlock Text="Search clients" Margin="15,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Padding="12,9"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource TextPrimary}"
                                 VerticalContentAlignment="Center" FontSize="14"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Segment}" GroupName="Browser" Tag="All" Content="All"
                                 Margin="0" Checked="Filter_Checked" IsChecked="True"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="Browser" Tag="Chrome" Content="Chrome"
                                 Margin="2,0,0,0" Checked="Filter_Checked"/>
                    <RadioButton Style="{StaticResource Segment}" GroupName="Browser" Tag="Edge" Content="Edge"
                                 Margin="2,0,0,0" Checked="Filter_Checked"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"
                           Text="{Binding CountText}" Foreground="{DynamicResource TextSecondary}"/>
            </Grid>

            <!-- The grid of client tiles. One ScaleTransform resizes everything, which keeps the slider smooth. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ItemsControl ItemsSource="{Binding View}" Margin="14,0,14,14" Focusable="False">
                    <ItemsControl.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                    </ItemsControl.LayoutTransform>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TileButton}" ToolTip="{Binding Tooltip}"
                                    Click="Tile_Click" MouseRightButtonUp="Tile_RightClick">
                                <Grid Width="140">
                                    <StackPanel>
                                        <Border Width="88" Height="88" CornerRadius="18" HorizontalAlignment="Center"
                                                Background="{Binding Fill}">
                                            <TextBlock Text="{Binding Initials}" Foreground="{Binding InitialsBrush}"
                                                       FontSize="32" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="{Binding Name}" Margin="0,9,0,0"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="36" FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding LastOpenedText}" Margin="0,2,0,0" FontSize="10.5"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LastOpenedText}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Style="{StaticResource StarButton}" Click="Star_Click"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,0,0"
                                            ToolTip="Favorite">
                                        <TextBlock FontFamily="Segoe UI Symbol" FontSize="17">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#x2606;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                                                            <Setter Property="Text" Value="&#x2605;"/>
                                                            <Setter Property="Foreground" Value="#F2B01E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}" FontSize="14"
                       Text="{Binding EmptyText}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- ============ Settings panel ============ -->
        <Border Grid.Column="2" Width="310" Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource Stroke}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="20,18,20,14">

                <Grid DockPanel.Dock="Top" Margin="0,0,0,22">
                    <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource GhostButton}" Content="&#x2715;" Padding="9,5"
                            HorizontalAlignment="Right" Click="CloseSettings_Click" ToolTip="Close settings"/>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding ConfigLocation}" FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                    <Button Style="{StaticResource PillButton}" Content="Quit Profile Launcher" Click="Quit_Click"/>
                </StackPanel>

                <StackPanel>
                    <!-- Hotkey -->
                    <TextBlock Style="{StaticResource SectionLabel}" Text="HOTKEY"/>
                    <Border Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Stroke}"
                            BorderThickness="1" CornerRadius="8">
                        <TextBox x:Name="HotkeyBox" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 Text="{Binding HotkeyText, Mode=OneWay}"
                                 Background="Transparent" BorderThickness="0" Padding="10,8" Cursor="Hand"
                                 TextAlignment="Center" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimary}"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                 GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus"/>
                    </Border>
                    <TextBlock x:Name="HotkeyStatus" Margin="2,6,0,22" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="Click the box, then press the keys you want."/>

                    <!-- Icon size -->
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="ICON SIZE" Margin="2,0,0,0"/>
                        <TextBlock Text="{Binding TileSizeText}" HorizontalAlignment="Right" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Grid>
                    <Slider Minimum="52" Maximum="160" Value="{Binding TileSize}" Margin="0,0,0,22"
                            SmallChange="2" LargeChange="12" IsMoveToPointEnabled="True"/>

                    <!-- Theme -->
                    <TextBlock Style="{StaticResource SectionLabel}" Text="THEME"/>
                    <UniformGrid Rows="1" Margin="0,0,0,22">
                        <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" GroupName="Theme"
                                     Tag="FollowSystem" Content="System" Margin="0" Checked="Theme_Checked"/>
                        <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" GroupName="Theme"
                                     Tag="Light" Content="Light" Margin="2,0,0,0" Checked="Theme_Checked"/>
                        <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" GroupName="Theme"
                                     Tag="Dark" Content="Dark" Margin="2,0,0,0" Checked="Theme_Checked"/>
                    </UniformGrid>

                    <!-- Behaviour -->
                    <TextBlock Style="{StaticResource SectionLabel}" Text="BEHAVIOR"/>
                    <CheckBox IsChecked="{Binding StartWithWindows}" Foreground="{DynamicResource TextPrimary}"
                              Margin="2,0,0,8">
                        <TextBlock TextWrapping="Wrap" Text="Start with Windows, quietly in the tray"/>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding CloseToTray}" Foreground="{DynamicResource TextPrimary}"
                              Margin="2,0,0,8">
                        <TextBlock TextWrapping="Wrap" Text="Keep running in the tray when closed, so the hotkey works"/>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding HideAfterLaunch}" Foreground="{DynamicResource TextPrimary}"
                              Margin="2,0,0,0">
                        <TextBlock TextWrapping="Wrap" Text="Hide the launcher after opening a portal"/>
                    </CheckBox>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
